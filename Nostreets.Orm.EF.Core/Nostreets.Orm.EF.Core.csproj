<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;ProjectRef;NugetRef</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />
  </ItemGroup>

  <!-- In-house dependency, switchable: live ProjectReference in Debug/Release/ProjectRef; published NuGet package (local feed) in NugetRef. -->
  <ItemGroup>
    <!-- A4-1's fix lives in `MatchesPrimaryKey` / `MatchesAnyPrimaryKey`, which are internal
         precisely so the predicate is testable without standing up a database. -->
    <InternalsVisibleTo Include="Nostreets.Orm.EF.Core.Test" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'NugetRef'">
    <ProjectReference Include="..\..\Nostreets.Extensions.Core\Nostreets.Extensions.Core\Nostreets.Extensions.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'NugetRef'">
    <PackageReference Include="Nostreets.Extensions.Core" Version="1.0.4" />
  </ItemGroup>

</Project>
